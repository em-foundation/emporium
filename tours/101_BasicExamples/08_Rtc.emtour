title: Real-Time Clock
files:
  - em.core:em.hal/RtcI.em.ts
  - em.core:em.utils/TimeTypes.em.ts
  - em.core:em.utils/AlarmMgr.em.ts
  - em.core:em.utils/UptimerRtc.em.ts
  - .assets/img-101-08-01.png

steps:

  - cmds:
      - view 5
    text: |

      {[ht,$start] Real-Time Clock} 

  - cmds:
      - open 1
    focus: [1,1]
    text: |

      {[ht,$peek] %[cu]RtcI% &ndash; Quick Look } 

  - cmds:
      - open 2
      - mark 2 A 11
      - mark 2 B 24
      - mark 2 C 28
    focus: [2,1]
    text: |

      {[ht,$details] %[cu]TimeTypes% &ndash; Details } 

  - cmds:
      - open 3
      - mark 3 A 9
      - mark 3 B 11
      - mark 3 C 13
      - mark 3 D 18
      - mark 3 E 25
      - mark 3 F 28
    focus: [3,1]
    text: |

      {[ht,$details] %[cu]AlarmMgr% &ndash; Details } 

  - cmds:
      - open 3

      - mark 3 A 9
      - mark 3 B 11
      - mark 3 C 13
      - mark 3 D 18
      - mark 3 E 25
      - mark 3 F 28

      - mark 3 G 39
      - mark 3 H 45
      - mark 3 I 49
      - mark 3 J 54
      - mark 3 K 60

    focus: [3,39]
    text: |

      {[ht,$details] %[cu]AlarmMgr% &ndash; More Details } 

  - cmds:
      - open 3

      - mark 3 A 9
      - mark 3 B 11
      - mark 3 C 13
      - mark 3 D 18
      - mark 3 E 25
      - mark 3 F 28

      - mark 3 G 39
      - mark 3 H 45
      - mark 3 I 49
      - mark 3 J 54
      - mark 3 K 60

      - mark 3 J 66

    focus: [3,69]
    text: |

      {[ht,$details] %[cu]AlarmMgr% &ndash; Still More Details } 

  - cmds:
    text: |

      {[ht,$extra] Extra Credit}

  - cmds:
    text: |

      {[ht,$steps] Next Steps}

  - cmds:
      - open 0
      - view 0
      - mark 0 A 4
      - close 0
    focus: [1,1]
    acts: [$reveal,$build]
    text: |

        {[ht,menu_book]%[cu]Unit% &ndash; Cheat Sheet}

        <div class="em-bmlist">

        {[bm,A]}

        </div>

        {[in]An insight}

        {[bi,home]} $start&thinsp; {[bi,build]} $build&thinsp; {[bi,description]} $details&thinsp; {[bi,credit_score]} $extra&thinsp; {[bi,search]} $look&thinsp;<br>
        {[bi,visibility]} $peek&thinsp; {[bi,footprint]} $steps&thinsp; {[bi,assignment_turned_in]} $done&thinsp; {[bi,event_list]} $todo

        {[bi,task_alt]} task_alt&thinsp; {[bi,sentiment_satisfied]} sentiment_satisfied&thinsp; {[bi,arrow_back]} arrow_back<br>
        {[bi,arrow_circle_right]} arrow_circle_right&thinsp; {[bi,counter_1]} counter_1 {[bi,recommend]} recommend<br>
        {[bi,monitor_heart]} monitor_heart&thinsp; {[bi,measuring_tape]} measuring_tape&thinsp;
        
        <span class="em codicon codicon-circuit-board"></span>&thinsp; <span class="em">Board</span>&thinsp; {[cb,target]}&thinsp; {[cb,build]}

        {[cd]cd} {[ce]ce} {[cf]cf} {[ck]ck} {[cn]cn} {[cs]cs} {[ct]ct} {[cu]cu} {[cx]cx} `code`

        {[hc]}
